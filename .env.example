# =============================================================================
# Ecunexo_cliente — variables Portainer / Docker Compose
# Pegar en Portainer → Stack → Env (o copiar a .env junto a docker-compose.yml)
# NUNCA subir .env al git.
# =============================================================================

# --- Imágenes / versión ---
CLIENTE_API_IMAGE=ecunexo-cliente-api:1.0.0
CLIENTE_SPA_IMAGE=ecunexo-cliente-spa:1.0.0

# --- Puertos publicados en el host ---
CLIENTE_API_HOST_PORT=5088
CLIENTE_SPA_HOST_PORT=5173

# --- Postgres (producto Cliente; BD distinta de licensing_ecunexo) ---
POSTGRES_DB=ecunexo
POSTGRES_USER=ecunexo
POSTGRES_PASSWORD=CAMBIA_PASSWORD_FUERTE_AQUI

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
DATABASE_MIGRATE_ON_STARTUP=true
DATABASE_SEED_CATALOG_ON_STARTUP=true

# JWT tenant API (mín. 32 caracteres). Distinto del JWT de Platform/Licencias.
JWT_ISSUER=EcuNexo
JWT_AUDIENCE=EcuNexo.Api
JWT_SIGNING_KEY=CAMBIA_ESTO_MINIMO_32_CARACTERES_ALEATORIOS!!

# Pepper legacy onboarding (mín. 16). No es el IssuePepper de Platform.
ACTIVATION_PEPPER=CAMBIA_PEPPER_ACTIVACION_MIN_16

# Debe ser el MISMO ValidationPepper que en el stack de Licencias.
VALIDATION_PEPPER=CAMBIA_PEPPER_VALIDACION_COMPARTIR_CON_PLATFORM_16

# ---------------------------------------------------------------------------
# Llave pública RSA (verifica artefacto de licencia)
# En Platform generaste license-private.pem + license-public.pem
# Aqui solo montas la PUBLICA:
#   /opt/ecunexo/cliente/keys/license-public.pem
# ---------------------------------------------------------------------------
LICENSE_PUBLIC_KEY_PATH=/keys/license-public.pem
LICENSE_KEYS_HOST_PATH=/opt/ecunexo/cliente/keys

# Validación online opcional (URL base Platform). Vacío = solo firma local.
# Ejemplo: https://licencias.tudominio.com  o  http://IP:5090
PLATFORM_API_BASE_URL=

# Clave compartida Billing → Cliente (header X-EcuNexo-Inventory-Key). Vacío = deshabilitado.
INVENTORY_EGRESS_API_KEY=

# Orígenes SPA si expones :5088 directo (sin proxy Nginx). Con mismo origen déjalo vacío.
# CORS_ALLOWED_ORIGINS=https://app.tudominio.com,http://TU_IP:5173
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# SPA build args
# Detrás de Cloudflare HTTPS: deja VITE_API_BASE_URL vacío (Nginx proxy /api).
# Si apuntas la SPA directo a la API: http://TU_IP:5088
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
# Facturación (stack Billing aparte). Vacío = no usa billing remoto.
VITE_BILLING_API_BASE_URL=
VITE_LOGNERD_ENABLE_CONSOLE=false
VITE_LOGNERD_LEVEL=WARN
