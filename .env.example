# =============================================================================
# Ecunexo_cliente — variables Portainer / Docker Compose
# Pegar en Portainer → Stack → Env (o copiar a .env junto a docker-compose.yml)
# NUNCA subir .env al git.
# =============================================================================

# --- Imágenes / versión ---
CLIENTE_API_IMAGE=ecunexo-cliente-api:1.0.0
CLIENTE_SPA_IMAGE=ecunexo-cliente-spa:1.0.0

# --- Puertos publicados en el host ---
CLIENTE_API_HOST_PORT=5088
CLIENTE_SPA_HOST_PORT=5173

# --- Postgres (solo producto Cliente: tenancy/catalog/inventory/…) ---
# Distinta de licensing_ecunexo y de la BD `billing` del stack Facturación.
# En Portainer puedes configurar el host, puerto, base de datos y credenciales individuales:
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecunexo
POSTGRES_USER=ecunexo
POSTGRES_PASSWORD=CAMBIA_PASSWORD_FUERTE_AQUI
# Opcional: Connection string completo directo si se usa base de datos externa o administrada en Portainer:
# DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=ecunexo;Username=ecunexo;Password=CAMBIA_PASSWORD_FUERTE_AQUI

# --- Motor de Correo Electrónico (Zoho Mail / SMTP) ---
# Nota: La configuración principal se administra y guarda en la base de datos desde el sistema web (Ajustes -> Motor de Correo).
# Estas variables de entorno son opcionales como valores de respaldo / inicialización:
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USERNAME=notificaciones@tudominio.com
# SMTP_PASSWORD=tu_app_password_de_zoho
# SMTP_SENDER_EMAIL=notificaciones@tudominio.com
# SMTP_SENDER_NAME=EcuNexo

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
DATABASE_MIGRATE_ON_STARTUP=true
DATABASE_SEED_CATALOG_ON_STARTUP=true

# JWT tenant API (mín. 32 caracteres). Distinto del JWT de Platform/Licencias.
JWT_ISSUER=EcuNexo
JWT_AUDIENCE=EcuNexo.Api
JWT_SIGNING_KEY=CAMBIA_ESTO_MINIMO_32_CARACTERES_ALEATORIOS!!

# Pepper legacy onboarding (mín. 16). No es el IssuePepper de Platform.
ACTIVATION_PEPPER=CAMBIA_PEPPER_ACTIVACION_MIN_16

# Debe ser el MISMO ValidationPepper que en el stack de Licencias.
VALIDATION_PEPPER=CAMBIA_PEPPER_VALIDACION_COMPARTIR_CON_PLATFORM_16

# ---------------------------------------------------------------------------
# Llave pública RSA (verifica artefacto de licencia)
# La clave pública ya viene integrada en la imagen/código (license-public.pem).
# Si deseas sobreescribirla opcionalmente, puedes especificar la ruta o el PEM:
# ---------------------------------------------------------------------------
LICENSE_PUBLIC_KEY_PATH=license-public.pem

# Validación online opcional (URL base Platform). Vacío = solo firma local.
# Ejemplo: https://licencias.tudominio.com  o  http://IP:5090
PLATFORM_API_BASE_URL=

# Clave compartida Billing.Api → Cliente API (header X-EcuNexo-Inventory-Key).
# Misma que INVENTORY_EGRESS_API_KEY en el stack Facturación. Vacío = deshabilitado.
INVENTORY_EGRESS_API_KEY=

# Orígenes SPA si expones :5088 directo (sin proxy Nginx). Con mismo origen déjalo vacío.
# CORS_ALLOWED_ORIGINS=https://app.tudominio.com,http://TU_IP:5173
CORS_ALLOWED_ORIGINS=

# --- Backblaze B2 / S3 Object Storage (Catálogo, Imágenes de Ítems y Reparaciones) ---
STORAGE_PROVIDER=BackblazeB2
STORAGE_SERVICE_URL=https://s3.us-east-005.backblazeb2.com
STORAGE_REGION=us-east-005
STORAGE_PUBLIC_BUCKET=ecunexo-publico-assets
STORAGE_PRIVATE_BUCKET=ecunexo-private-assets
STORAGE_KEY_ID=
STORAGE_APPLICATION_KEY=

# ---------------------------------------------------------------------------
# SPA build args
# Detrás de Cloudflare HTTPS: deja VITE_API_BASE_URL vacío (Nginx proxy /api).
# Si apuntas la SPA directo a la API: http://TU_IP:5088
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
# Facturación: URL de Billing.Api (BD billing aparte). Obligatoria en prod si usas facturación.
# Ej.: http://150.136.6.60:8081  o  https://billing.tudominio.com
# Rebuild de la imagen SPA tras cambiar. Vacío = UI de billing sin backend remoto.
VITE_BILLING_API_BASE_URL=
VITE_LOGNERD_ENABLE_CONSOLE=false
VITE_LOGNERD_LEVEL=WARN
