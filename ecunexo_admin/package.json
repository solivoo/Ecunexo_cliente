    "test:ui:grupo": "playwright test tests-ui/planes/grupo",
    "test:ui:ciclo": "E2E_LICENSE_MATRIX=1 playwright test tests-ui/planes/ciclo-licencia.spec.ts",
    "test:ui:plans": "E2E_LICENSE_MATRIX=1 playwright test tests-ui/planes/ciclo-licencia.spec.ts",
    "test:ui:report": "playwright show-report",
    "postinstall": "node scripts/patch-glubox-types.mjs"
