    "test:ui:independiente:ui": "playwright test --ui tests-ui/planes/independiente",
    "test:ui:local": "playwright test tests-ui/planes/local",
    "test:ui:taller": "playwright test tests-ui/planes/taller",
    "test:ui:empresa": "playwright test tests-ui/planes/empresa",
